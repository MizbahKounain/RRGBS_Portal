# Server
NODE_ENV=production
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
APP_ORIGIN=https://your-render-service.onrender.com
DB_POOL_MAX=10

# PostgreSQL (Render: use the INTERNAL database URL when the web service and DB share a region)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Production email - Resend uses HTTPS, so this works on Render without SMTP ports.
# For testing, Resend can use its test sender according to its current account/domain rules.
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=RRGBS <info@your-verified-domain.example>
EMAIL_TO=info@rrgroupofbusinesssolutions.in
PASSWORD_RESET_TTL_MINUTES=15

# Persistent resume storage - Cloudinary raw/private assets.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Alternatively, you can use one CLOUDINARY_URL instead of the three variables above.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
